package pract6;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class ComputerShopApp {
    private static final List<Computer> catalog = new ArrayList<>();
    private static final Scanner scanner = new Scanner(System.in);

    public static void main(String[] args) {
        initCatalog();
        boolean running = true;
        while (running) {
            printMenu();
            String choice = scanner.nextLine().trim();
            switch (choice) {
                case "1" -> showAll();
                case "2" -> searchByBrand();
                case "3" -> filterByMaxPrice();
                case "0" -> running = false;
                default -> System.out.println("Неверный пункт меню.");
            }
        }
        System.out.println("Выход из магазина. До свидания!");
    }

    private static void initCatalog() {
        catalog.add(new Computer("Apple", "MacBook Pro 14", "Apple M3 Pro", 18, 249990));
        catalog.add(new Computer("ASUS", "ROG Zephyrus G14", "AMD Ryzen 9", 32, 189990));
        catalog.add(new Computer("Lenovo", "ThinkPad X1 Carbon", "Intel Core i7", 16, 159990));
        catalog.add(new Computer("HP", "Pavilion 15", "Intel Core i5", 8, 64990));
        catalog.add(new Computer("Apple", "MacBook Air 13", "Apple M2", 8, 114990));
    }

    private static void printMenu() {
        System.out.println("\n=== Интернет-магазин компьютерной техники ===");
        System.out.println("1. Показать весь каталог");
        System.out.println("2. Найти по бренду");
        System.out.println("3. Фильтр по максимальной цене");
        System.out.println("0. Выход");
        System.out.print("Ваш выбор: ");
    }

    private static void showAll() {
        System.out.println("\n--- Каталог ---");
        catalog.forEach(Computer::print);
    }

    private static void searchByBrand() {
        System.out.print("Введите бренд: ");
        String brand = scanner.nextLine().trim();
        boolean found = false;
        for (Computer c : catalog) {
            if (c.getBrand().equalsIgnoreCase(brand)) {
                c.print();
                found = true;
            }
        }
        if (!found) System.out.println("Ничего не найдено.");
    }

    private static void filterByMaxPrice() {
        System.out.print("Введите максимальную цену: ");
        try {
            double max = Double.parseDouble(scanner.nextLine().trim());
            catalog.stream()
                    .filter(c -> c.getPrice() <= max)
                    .forEach(Computer::print);
        } catch (NumberFormatException e) {
            System.out.println("Ошибка: введите число.");
        }
    }

package pract6;

public interface MathCalculable {
    double PI = 3.141592653589793;

    double power(double base, double exponent);

    double absComplex(double real, double imaginary);
}

package pract6;

public class MathFunc implements MathCalculable {

    @Override
    public double power(double base, double exponent) {
        return Math.pow(base, exponent);
    }

    @Override
    public double absComplex(double real, double imaginary) {
        return Math.sqrt(real * real + imaginary * imaginary);
    }

    // Длина окружности: 2 * PI * R — использует PI из интерфейса
    public double circumference(double radius) {
        return 2 * PI * radius;
    }

    // Площадь круга: PI * R^2
    public double circleArea(double radius) {
        return PI * power(radius, 2);
    }
}

package pract6;

public class MathFuncTest {
    public static void main(String[] args) {
        MathCalculable mc = new MathFunc();

        System.out.println("2^10       = " + mc.power(2, 10));
        System.out.println("|3 + 4i|   = " + mc.absComplex(3, 4));

        MathFunc mf = new MathFunc();
        System.out.println("Длина окружности R=5   = " + mf.circumference(5));
        System.out.println("Площадь круга R=5      = " + mf.circleArea(5));

        // Проверка из замечания к заданию:
        // MathCalculable mc2 = new MathCalculable(); — ошибка компиляции!
    }
}

package pract6;

public interface StringOperations {
    int countChars(String s);
    String oddChars(String s);
    String reverse(String s);
}

package pract6;

public class ProcessStrings implements StringOperations {

    @Override
    public int countChars(String s) {
        return s.length();
    }

    @Override
    public String oddChars(String s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i += 2) {  // позиции 1,3,5 → индексы 0,2,4
            sb.append(s.charAt(i));
        }
        return sb.toString();
    }

    @Override
    public String reverse(String s) {
        return new StringBuilder(s).reverse().toString();
    }
}

package pract6;

public class ProcessStringsTest {
    public static void main(String[] args) {
        StringOperations ops = new ProcessStrings();
        String s = "Программирование";

        System.out.println("Исходная строка: " + s);
        System.out.println("Кол-во символов: " + ops.countChars(s));
        System.out.println("Символы на нечётных позициях: " + ops.oddChars(s));
        System.out.println("Инверсия: " + ops.reverse(s));
    }
}

