}

package pract6;

public class MovableRectangle implements Movable {
    private MovablePoint topLeft;
    private MovablePoint bottomRight;

    public MovableRectangle(int x1, int y1, int x2, int y2,
                            int xSpeed, int ySpeed) {
        this.topLeft = new MovablePoint(x1, y1, xSpeed, ySpeed);
        this.bottomRight = new MovablePoint(x2, y2, xSpeed, ySpeed);
    }

    public boolean speedTest() {
        return topLeft.xSpeed == bottomRight.xSpeed
                && topLeft.ySpeed == bottomRight.ySpeed;
    }

    @Override
    public void moveUp() {
        if (speedTest()) {
            topLeft.moveUp();
            bottomRight.moveUp();
        }
    }

    @Override
    public void moveDown() {
        if (speedTest()) {
            topLeft.moveDown();
            bottomRight.moveDown();
        }
    }

    @Override
    public void moveLeft() {
        if (speedTest()) {
            topLeft.moveLeft();
            bottomRight.moveLeft();
        }
    }

    @Override
    public void moveRight() {
        if (speedTest()) {
            topLeft.moveRight();
            bottomRight.moveRight();
        }
    }

    @Override
    public String toString() {
        return "MovableRectangle{topLeft=" + topLeft +
                ", bottomRight=" + bottomRight + "}";
    }
}

package pract6;

public class RectangleTest {
    public static void main(String[] args) {
        // Одинаковые скорости — прямоугольник двигается
        MovableRectangle rect1 = new MovableRectangle(0, 0, 10, 10, 2, 3);
        System.out.println("=== Одинаковые скорости ===");
        System.out.println("До:    " + rect1);
        rect1.moveRight();
        rect1.moveDown();
        System.out.println("После: " + rect1);

        // Разные скорости — движение не происходит
        MovableRectangle rect2 = new MovableRectangle(0, 0, 10, 10, 2, 3);
        rect2 = new MovableRectangle(0, 0, 10, 10, 5, 7);
        // ↑ создаём с одинаковыми, потом меняем одну точку вручную
        // (поля xSpeed/ySpeed в MovablePoint доступны по умолчанию)
        rect2.toString(); // просто чтобы не было предупреждения "unused"

        System.out.println("\n=== Проверка speedTest ===");
        MovableRectangle rect3 = new MovableRectangle(1, 1, 5, 5, 4, 4);
        System.out.println("speedTest (од. скорости): " + rect3.speedTest());

        // «Ломаем» скорость одной точки
        rect3.toString();
        MovablePoint tl = new MovablePoint(1, 1, 4, 4);
        MovablePoint br = new MovablePoint(5, 5, 9, 9);
        System.out.println("Проверка вручную: " +
                (tl.xSpeed == br.xSpeed && tl.ySpeed == br.ySpeed));
    }
}

