package pract11;

import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Scanner;

public class DateCompare {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        SimpleDateFormat sdf = new SimpleDateFormat("dd.MM.yyyy");
        sdf.setLenient(false); // строгая проверка даты

        System.out.print("Введите дату в формате дд.ММ.гггг: ");
        String input = scanner.nextLine().trim();

        try {
            Date userDate = sdf.parse(input);
            Date today = new Date();

            // Обнуляем время у обеих дат, чтобы сравнивать только день
            SimpleDateFormat dayOnly = new SimpleDateFormat("dd.MM.yyyy");
            Date todayDay = dayOnly.parse(dayOnly.format(today));

            System.out.println("Текущая дата: " + dayOnly.format(today));
            System.out.println("Введённая:    " + dayOnly.format(userDate));

            if (userDate.before(todayDay)) {
                System.out.println("Введённая дата в прошлом.");
            } else if (userDate.after(todayDay)) {
                System.out.println("Введённая дата в будущем.");
            } else {
                System.out.println("Введённая дата совпадает с текущей.");
            }
        } catch (ParseException e) {
            System.out.println("Ошибка: введите дату в формате дд.ММ.гггг, " +
                    "например 05.11.2026");
        }

        scanner.close();
    }
}

package pract11;

import java.text.SimpleDateFormat;
import java.util.Date;

public class Student {
    private String name;
    private Date birthDate;

    public Student(String name, Date birthDate) {
        this.name = name;
        this.birthDate = birthDate;
    }

    public String getName() { return name; }
    public Date getBirthDate() { return birthDate; }

    // toString() — полный формат
    @Override
    public String toString() {
        return "Student{name='" + name + "', birthDate=" +
                formatBirthDate("full") + "}";
    }

    // Метод возвращает дату рождения в нужном формате
    // format: "short", "medium", "full"
    public String formatBirthDate(String format) {
        if (birthDate == null) return "не указана";

        String pattern;
        switch (format.toLowerCase()) {
            case "short"  -> pattern = "dd.MM.yy";
            case "medium" -> pattern = "dd MMM yyyy";
            case "full"   -> pattern = "dd MMMM yyyy (EEEE)";
            default       -> pattern = "dd.MM.yyyy";
        }
        return new SimpleDateFormat(pattern).format(birthDate);
    }
}

