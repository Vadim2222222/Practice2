package pract11;

import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.Scanner;

public class UserDateInput {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Введите дату и время:");
        System.out.print("Год:    ");
        int year = Integer.parseInt(scanner.nextLine().trim());
        System.out.print("Месяц (1-12): ");
        int month = Integer.parseInt(scanner.nextLine().trim());
        System.out.print("Число:  ");
        int day = Integer.parseInt(scanner.nextLine().trim());
        System.out.print("Часы (0-23): ");
        int hour = Integer.parseInt(scanner.nextLine().trim());
        System.out.print("Минуты: ");
        int minute = Integer.parseInt(scanner.nextLine().trim());

        // === Вариант 1: через Calendar ===
        Calendar cal = Calendar.getInstance();
        cal.set(Calendar.YEAR, year);
        cal.set(Calendar.MONTH, month - 1); // в Calendar месяцы с 0!
        cal.set(Calendar.DAY_OF_MONTH, day);
        cal.set(Calendar.HOUR_OF_DAY, hour);
        cal.set(Calendar.MINUTE, minute);
        cal.set(Calendar.SECOND, 0);
        cal.set(Calendar.MILLISECOND, 0);
        Date dateFromCalendar = cal.getTime();

        // === Вариант 2: через Date (миллисекунды с 1970) ===
        // Проще всего — взять готовый Calendar и превратить в Date
        Date dateFromDate = new Date(dateFromCalendar.getTime());

        SimpleDateFormat sdf = new SimpleDateFormat("dd.MM.yyyy HH:mm:ss");

        System.out.println();
        System.out.println("=== Результаты ===");
        System.out.println("Date:     " + sdf.format(dateFromDate));
        System.out.println("Calendar: " + sdf.format(dateFromCalendar));
        System.out.println("Миллисекунды с 1970: " + dateFromCalendar.getTime());
        System.out.println("Calendar.get(YEAR) = " + cal.get(Calendar.YEAR));
        System.out.println("Calendar.get(MONTH) = " + cal.get(Calendar.MONTH)); // 0-based
        System.out.println("Calendar.get(DAY_OF_MONTH) = " + cal.get(Calendar.DAY_OF_MONTH));
        System.out.println("Calendar.get(HOUR_OF_DAY) = " + cal.get(Calendar.HOUR_OF_DAY));
        System.out.println("Calendar.get(MINUTE) = " + cal.get(Calendar.MINUTE));

        scanner.close();
    }
}

